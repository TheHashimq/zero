<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/geass_gradient_bg">

    <!-- Subtle grid overlay effect -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_overlay"
        android:alpha="0.03" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="36dp">

        <!-- Header: Geass Symbol & Zero Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="56dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_geass"
                    android:alpha="0.95"
                    android:scaleType="centerInside" />

                <!-- Glow effect -->
                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/geass_glow"
                    android:alpha="0.2" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z E R O"
                android:textColor="#FF6B00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:background="@drawable/accent_line"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMAND PROTOCOL"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Timer Display: Strategic Command Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/command_panel_bg"
            android:padding="36dp"
            android:gravity="center"
            android:layout_marginBottom="48dp">

            <!-- Status Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● OPERATION STATUS"
                android:textColor="#00DD00"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace"
                android:layout_marginBottom="24dp" />

            <!-- Timer with Geass styling -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90:00"
                    android:textColor="#FF6B00"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="-0.02" />

            </LinearLayout>

            <!-- Status Text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHIELD ENGAGED"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Info text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕ LONG PRESS FOR TACTICAL LOG"
                android:textColor="#555555"
                android:textSize="8sp"
                android:letterSpacing="0.06"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Action Buttons: Strategic Command Style -->
        <Button
            android:id="@+id/btnStartDelay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="▶ INITIATE PROTOCOL"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="monospace"
            android:background="@drawable/geass_button_primary"
            android:layout_marginBottom="14dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnEnablePermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙ ENABLE AUTHORITY"
            android:textColor="#DDDDDD"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:fontFamily="monospace"
            android:background="@drawable/geass_button_secondary"
            android:stateListAnimator="@null" />

    </LinearLayout>

</FrameLayout>