<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111111" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#FF6B00" />
        </shape>
    </item>

    <!-- Inner glow effect -->
    <item android:bottom="0dp" android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#22FF6B00"
                android:endColor="#00FF6B00"
                android:angle="90" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>